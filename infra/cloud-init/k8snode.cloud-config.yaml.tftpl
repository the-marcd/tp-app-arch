#cloud-config
# Bootstrap for a k8s worker: pull this repo and run the k8snode playbook
# against localhost. Same mechanism as the control plane -- see
# k8smaster.cloud-config.yaml.tftpl for the behaviours this relies on.
#
# A separate template rather than sharing the master's: the package lists
# differ, and editing the master's template would change its rendered user_data
# and force that instance to be replaced.
#
# Runs once, on first boot only. Editing this template does not re-run it on a
# live instance; the instance has to be replaced (user_data_replace_on_change).
#
# ORDERING: the k8snode role fetches the join command from S3, which the master
# only writes after its own kubeadm init completes. A worker that boots first
# fails on that object not existing -- see README.

package_update: true

packages:
  # ansible-pull clones over git.
  - git
  # ansible.builtin.deb822_repository (roles/common) needs python3-debian.
  - python3-debian
  # amazon.aws.s3_object (roles/k8snode) needs boto3.
  - python3-boto3
  # No python3-kubernetes here: unlike the control-plane role, k8snode uses no
  # kubernetes.core modules.

ansible:
  # The distro `ansible` package, not `ansible-core`: the roles use the
  # ansible.posix and amazon.aws collections, which only the full package bundles.
  install_method: distro
  package_name: ansible
  pull:
    url: ${repo_url}
    playbook_name: ${playbook}

output:
  all: '| tee -a /var/log/cloud-init-output.log'
